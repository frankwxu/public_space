# Public-materials whitelist: ignore everything unless explicitly allowed below.
/*

!.gitignore
!README.md
!.vscode/
!.vscode/**

!teaching/
teaching/**
!teaching/**/
!teaching/*/syllabus/*.tex
!teaching/*/syllabus/*.pdf

!teaching/lab_instructions/
!teaching/lab_instructions/**/*.tex
!teaching/lab_instructions/**/*.pdf
!teaching/lab_instructions/images/
!teaching/lab_instructions/images/**

# Allow README files at any depth, regardless of capitalization.
!**/
!**/[Rr][Ee][Aa][Dd][Mm][Ee].[Mm][Dd]
