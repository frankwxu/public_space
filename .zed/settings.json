{
  "auto_install_extensions": {
    "latex": true
  },
  "languages": {
    "LaTeX": {
      "language_servers": [
        "!texpresso-lsp",
        "texlab",
        "..."
      ]
    }
  },
  "lsp": {
    "texlab": {
      "binary": {
        "path": "/bin/sh",
        "arguments": [
          "/home/frank/public_space/.zed/texlab-scoped.sh"
        ]
      },
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true,
            "executable": "latexmk",
            "args": [
              "-pdf",
              "-interaction=nonstopmode",
              "-synctex=1",
              "%f"
            ]
          },
          "forwardSearch": {
            "executable": "python3",
            "args": [
              "/home/frank/public_space/.zed/latex_forward_search.py",
              "%p"
            ]
          }
        }
      }
    }
  }
}
